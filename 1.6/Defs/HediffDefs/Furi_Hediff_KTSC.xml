<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<HediffDef>
        <defName>FR_KTBlood</defName>
        <label>氷玥之赐</label>
        <description>氷玥之辉的恩赐。</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(255,90,0)</defaultLabelColor>
        <isBad>false</isBad>
        <priceImpact>true</priceImpact>
        <scenarioCanAdd>false</scenarioCanAdd>
        <allowMothballIfLowPriorityWorldPawn>true</allowMothballIfLowPriorityWorldPawn>
        <stages>
        <li>
			<becomeVisible>false</becomeVisible>
            <makeImmuneTo>
                <li>Flu</li>
                <li>Animal_Flu</li>
                <li>Plague</li>
                <li>Animal_Plague</li>
                <li>GutWorms</li>
                <li>Malaria</li>
                <li>MuscleParasites</li>
                <li>SleepingSickness</li>
            </makeImmuneTo>
        </li>
        </stages>
        <comps>
            <li MayRequire="rabiosus.autoblink" Class="AutoBlink.HediffCompProperties_AutoBlink">
                <minDistanceToBlink>5</minDistanceToBlink>
                <maxDistanceToBlink>99999</maxDistanceToBlink>
                <blinkIntervalTicks>6</blinkIntervalTicks>
                <delayAfterEligibleTicks>10</delayAfterEligibleTicks>
                <cellsBeforeTarget>1</cellsBeforeTarget>
                <postBlinkStanceTicks>0</postBlinkStanceTicks>
                <defaultAutoBlinkDrafted>true</defaultAutoBlinkDrafted>
                <defaultAutoBlinkIdle>true</defaultAutoBlinkIdle>
                <defaultJumpAsFarAsPossible>true</defaultJumpAsFarAsPossible>
                <playerFactionOnly>false</playerFactionOnly>
                <excludedJobDefs>
                    <li>GotoWander</li>
                    <li>Carried</li>
                </excludedJobDefs>
                <drawGizmo>true</drawGizmo>
                <gizmoIconPath>UI/Commands/AutoBlink</gizmoIconPath>
                <preBlinkSoundDefs>
                    <li>AutoBlink_Skip_Small</li>
                </preBlinkSoundDefs>
                <preBlinkEffecterDefs>
                    <li>Skip_Entry</li>
                </preBlinkEffecterDefs>
                <postBlinkSoundDefs>
                    <li>AutoBlink_Skip_Exit_Small</li>
                </postBlinkSoundDefs>
                <postBlinkEffecterDefs>
                    <li>Skip_ExitNoDelay</li>
                </postBlinkEffecterDefs>
            </li>
            <li MayRequire="xyzf.PsychicNexusCore" Class="xyzf.MAP.PsychicNexusCore.HediffCompProperties_PsychicPotential">
                <initialRecoveryPercent>1.0</initialRecoveryPercent>
                <periodicRecoveryPercent>1.0</periodicRecoveryPercent>
            </li>
            <li MayRequire="xyzf.PsychicNexusCore" Class="xyzf.MAP.PsychicNexusCore.HediffCompProperties_NoPsyfocusCost"/>
        </comps>
    </HediffDef>
</Defs>