<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <RecipeDef>
    <defName>FR_Trace_Origin_Unit1</defName>
    <label>溯源源素x500</label>
    <description>溯源500单位源素。</description>
    <jobString>溯源500单位源素中……</jobString>
    <effectWorking>Cremate</effectWorking>
    <soundWorking>Recipe_Cremate</soundWorking>
    <workAmount>2000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>StoneBlocks</li>
			      <li>Leathers</li>
			      <li>Textiles</li>
			      <li>Wools</li>
            <li>FoodRaw</li>
            <li>PlantMatter</li>
			    </categories>
          <thingDefs>
            <li>Silver</li>
          </thingDefs>
        </filter>
        <count>1000</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
		  <categories>
        <li>StoneBlocks</li>
		    <li>Leathers</li>
		    <li>Textiles</li>
		    <li>Wools</li>
        <li>FoodRaw</li>
        <li>PlantMatter</li>
			</categories>
      <thingDefs>
        <li>Silver</li>
      </thingDefs>
      <disallowedThingDefs>
        <li>FR_Origin_Silk</li>
        <li>FR_Origin_EnchantSilk</li>
      </disallowedThingDefs>
	  </fixedIngredientFilter>
    <products>
      <FR_Origin_Unit>500</FR_Origin_Unit>
    </products>
	  <recipeUsers>
      <li>Miho_ShaftFurnace</li>
	  </recipeUsers>
	  <researchPrerequisite>FR_Origin_Tech</researchPrerequisite>
  </RecipeDef>

