<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <RecipeDef>
    <defName>FR_Make_Origin_Silk</defName>
    <label>炼制源素丝绸x50</label>
    <description>炼制50源素丝绸。</description>
    <jobString>炼制50源素丝绸中……</jobString>
    <effectWorking>Cremate</effectWorking>
    <soundWorking>Recipe_Cremate</soundWorking>
    <workAmount>2000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredients>
      <li>
        <filter>
          <categories>
			      <li>Leathers</li>
		        <li>Textiles</li>
		        <li>Wools</li>
		      </categories>
        </filter>
        <count>200</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>FR_Origin_Unit</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
	  <categories>
	    <li>Leathers</li>
		  <li>Textiles</li>
		  <li>Wools</li>
	  </categories>
    <disallowedThingDefs>
      <li>FR_Origin_Silk</li>
      <li>FR_Origin_EnchantSilk</li>
    </disallowedThingDefs>
	  </fixedIngredientFilter>
    <products>
      <FR_Origin_Silk>50</FR_Origin_Silk>
    </products>
	  <recipeUsers>
      <li>Miho_ShaftFurnace</li>
	  </recipeUsers>
	  <researchPrerequisite>FR_OriginSilk_Tech</researchPrerequisite>
  </RecipeDef>

