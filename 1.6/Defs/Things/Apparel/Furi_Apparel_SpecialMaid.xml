<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="ApparelMakeableBase">
    <defName>FR_Miho_SpecialMaid</defName>
    <label>美狐女仆团制服</label>
    <description>美狐女仆团的可爱女仆们穿着的女仆装制服。</description>
    <graphicData>
      <texPath>Things/Apparel/Miho_SpecialMaid/FR_Miho_SpecialMaid</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <costStuffCount>70</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <costList>
      <Miho_Ebony_SilkCloth>70</Miho_Ebony_SilkCloth>
    </costList>
    <thingCategories>
      <li>Miho_Apparel</li>
    </thingCategories>
    <recipeMaker>
	  <researchPrerequisite>Miho_ApparelAdvanced</researchPrerequisite> 

      <recipeUsers Inherit="false">
	          <li>Miho_TableMachining</li>
      </recipeUsers>
    </recipeMaker>
    <statBases>
	  <MaxHitPoints>180</MaxHitPoints>
	  <WorkToMake>25000</WorkToMake>
      <Mass>1</Mass>
      <StuffEffectMultiplierArmor>0.7</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.7</StuffEffectMultiplierInsulation_Cold>
	  <Insulation_Cold>9</Insulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.7</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <GeneralLaborSpeed>0.25</GeneralLaborSpeed>
      <SocialImpact>0.1</SocialImpact>
      <AL_ShroudPotential>1.05</AL_ShroudPotential>
      <AL_CastShroudWarmUpFactor>-0.15</AL_CastShroudWarmUpFactor>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
		<li>Arms</li>
		<li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Apparel/Miho_SpecialMaid/FR_Miho_SpecialMaid</wornGraphicPath>
			<useWornGraphicMask>true</useWornGraphicMask>
      <layers>
        <li>OnSkin</li>
      </layers>
      <tags>
        <li>FR_Miho_SpecialMaid_Tag</li>
      </tags>
      <defaultOutfitTags>
        <li>Worker</li>
      </defaultOutfitTags>
    </apparel>
    <colorGenerator Class="ColorGenerator_StandardApparel" />
  </ThingDef>

</Defs>