<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <DamageDef Name="OathSlash_Cut">
    <defName>OathSlash_Cut</defName>
    <label>OathSlash Cut</label>
    <workerClass>AriandelLibrary.DamageWorker_AddInjury_NoDamageFactor</workerClass>
    <externalViolence>false</externalViolence>
    <deathMessage>{0}被誓约之刃斩杀</deathMessage>
    <hediff>OathCut</hediff>
    <hediffSkin>OathCut</hediffSkin>
    <hediffSolid>OathCut</hediffSolid>
    <harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
    <impactSoundType>Slice</impactSoundType>
    <armorCategory>Sharp</armorCategory>
    <overkillPctToDestroyPart>0~0.2</overkillPctToDestroyPart>
    <buildingDamageFactor>1.314</buildingDamageFactor>
    <bluntStunDuration>5.2</bluntStunDuration>
    <bluntInnerHitChance>0.52</bluntInnerHitChance>
    <bluntInnerHitDamageFractionToConvert>0.52~1.314</bluntInnerHitDamageFractionToConvert>
    <bluntInnerHitDamageFractionToAdd>0.52~1.314</bluntInnerHitDamageFractionToAdd>
    <bluntStunChancePerDamagePctOfCorePartToHeadCurve>
      <points>
        <li>(0.04, 0.25)</li>
        <li>(0.4, 1)</li>
      </points>
    </bluntStunChancePerDamagePctOfCorePartToHeadCurve>
    <bluntStunChancePerDamagePctOfCorePartToBodyCurve>
      <points>
        <li>(0.2, 0)</li>
        <li>(0.7, 0.5)</li>
      </points>
    </bluntStunChancePerDamagePctOfCorePartToBodyCurve>
    <additionalHediffs>
      <li>
        <hediff>OathSlash_Hediff</hediff>
        <severityPerDamageDealt>0.052</severityPerDamageDealt>
        <victimSeverityScalingByInvBodySize>true</victimSeverityScalingByInvBodySize>
      </li>
    </additionalHediffs>
    <modExtensions>
      <li Class="AriandelLibrary.AL_NoDamageFactor_Extension">
        <penetrationFactor>5.2</penetrationFactor>
      </li>
      <li Class="AriandelLibrary.AL_DamageExtension_Scaling">
        <sizeFactor>0.52</sizeFactor>
      </li>
    </modExtensions>
  </DamageDef>
  
  <ManeuverDef>
    <defName>OathSlash</defName>
    <requiredCapacity>OathSlash_Cut</requiredCapacity>
    <verb>
      <verbClass>Verb_MeleeAttackDamage</verbClass>
      <meleeDamageDef>OathSlash_Cut</meleeDamageDef>
    </verb>
    <logEntryDef>MeleeAttack</logEntryDef>
    <combatLogRulesHit>Maneuver_Slash_MeleeHit</combatLogRulesHit>
    <combatLogRulesDeflect>Maneuver_Slash_MeleeDeflect</combatLogRulesDeflect>
    <combatLogRulesMiss>Maneuver_Slash_MeleeMiss</combatLogRulesMiss>
    <combatLogRulesDodge>Maneuver_Slash_MeleeDodge</combatLogRulesDodge>
    <modExtensions Inherit="false">
      <li MayRequire="Ariandel.MiliraImperium" Class="AncotLibrary.Effecter_Extension">
        <effcterDef>Milira_SlashCharged</effcterDef>
      </li>
      <li MayRequire="Ariandel.MiliraImperium" Class="MiliraImperium.MI_MeleeHediff_Extension">
        <applyToCaster>
          <li>
            <hediffDef>OathSlash_Fight_Hediff</hediffDef>
            <severity>0.1314</severity>
          </li>
        </applyToCaster>
        <applyToTarget>
          <li>
            <hediffDef>OathSlash_Hediff</hediffDef>
            <severity>0.1314</severity>
          </li>
          <li>
            <hediffDef>MI_Hediff_Doom</hediffDef>
            <severity>0.1314</severity>
          </li>
        </applyToTarget>
      </li>
      <li MayRequire="Ariandel.MiliraImperium" Class="MiliraImperium.MI_DoomSeverityExtension">
        <severityPerHit>5.2</severityPerHit>
      </li>
    </modExtensions>
  </ManeuverDef>

  <HediffDef Name="OathCut_Injury" Abstract="True">
    <hediffClass>Hediff_Injury</hediffClass>
    <tendable>false</tendable>
    <displayWound>false</displayWound>
    <labelNounPretty>{0}在{1}</labelNounPretty>
  </HediffDef>

  <HediffDef ParentName="OathCut_Injury">
    <defName>OathCut</defName>
    <label>溯源损伤</label>
    <labelNoun>一处溯源损伤</labelNoun>
    <description>一处因源素溯源解离而造成的损伤。</description>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.4</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
      <li Class="HediffCompProperties_Infecter">
        <infectionChance>0.52</infectionChance>
      </li>
      <li Class="HediffCompProperties_GetsPermanent">
        <permanentLabel>永久解离</permanentLabel>
      </li>
    </comps>
    <injuryProps>
      <painPerSeverity>0.052</painPerSeverity>
      <averagePainPerSeverityPermanent>0.01314</averagePainPerSeverityPermanent>
      <canMerge>true</canMerge>
      <destroyedLabel>解离缺失</destroyedLabel>
    </injuryProps>
  </HediffDef>

  <HediffDef>
    <defName>OathSlash_Hediff</defName>
    <label>御狐溯源侵袭</label>
    <description>受到御狐直指根源的打击。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1.0, 0.9, 0.7)</defaultLabelColor>
    <lethalSeverity>2</lethalSeverity>
    <scenarioCanAdd>true</scenarioCanAdd>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <label>五级溯源解离</label>
        <minSeverity>0.2</minSeverity>
        <statOffsets>
          <ArmorRating_Sharp>-0.52</ArmorRating_Sharp>
	        <ArmorRating_Blunt>-0.52</ArmorRating_Blunt>
          <IncomingDamageFactor>0.52</IncomingDamageFactor>
     	  </statOffsets>
        <capMods>
          <li><capacity>Consciousness</capacity><setMax>0.52</setMax></li>
          <li><capacity>Moving</capacity><setMax>0.52</setMax></li>
          <li><capacity>Manipulation</capacity><setMax>0.52</setMax></li>
        </capMods>
      </li>
      <li>
        <label>四级溯源解离</label>
        <minSeverity>0.4</minSeverity>
        <statOffsets>
          <ArmorRating_Sharp>-0.92</ArmorRating_Sharp>
	        <ArmorRating_Blunt>-0.72</ArmorRating_Blunt>
          <IncomingDamageFactor>0.72</IncomingDamageFactor>
     	  </statOffsets>
        <capMods>
          <li><capacity>Consciousness</capacity><setMax>0.26</setMax></li>
          <li><capacity>Moving</capacity><setMax>0.27</setMax></li>
          <li><capacity>Manipulation</capacity><setMax>0.27</setMax></li>
        </capMods>
      </li>
      <li>
        <label>三级溯源解离</label>
        <minSeverity>0.7</minSeverity>
        <statOffsets>
          <ArmorRating_Sharp>-1.4</ArmorRating_Sharp>
	        <ArmorRating_Blunt>-1.3</ArmorRating_Blunt>
          <IncomingDamageFactor>1.134</IncomingDamageFactor>
     	  </statOffsets>
        <capMods>
          <li><capacity>Consciousness</capacity><setMax>0.13</setMax></li>
          <li><capacity>Moving</capacity><setMax>0.14</setMax></li>
          <li><capacity>Manipulation</capacity><setMax>0.14</setMax></li>
        </capMods>
      </li>
      <li>
        <label>二级溯源解离</label>
        <minSeverity>1.0</minSeverity>
        <statOffsets>
          <ArmorRating_Sharp>-2.14</ArmorRating_Sharp>
	        <ArmorRating_Blunt>-2.13</ArmorRating_Blunt>
          <IncomingDamageFactor>2.134</IncomingDamageFactor>
     	  </statOffsets>
        <capMods>
          <li><capacity>Consciousness</capacity><setMax>0.052</setMax></li>
          <li><capacity>Moving</capacity><setMax>0.09</setMax></li>
          <li><capacity>Manipulation</capacity><setMax>0.09</setMax></li>
        </capMods>
      </li>
      <li>
        <label>一级溯源解离</label>
        <minSeverity>1.4</minSeverity>
        <statOffsets>
          <ArmorRating_Sharp>-5.2</ArmorRating_Sharp>
	        <ArmorRating_Blunt>-5.2</ArmorRating_Blunt>
          <IncomingDamageFactor>5.2</IncomingDamageFactor>
     	  </statOffsets>
        <capMods>
          <li><capacity>Consciousness</capacity><setMax>0</setMax></li>
          <li><capacity>Moving</capacity><setMax>0</setMax></li>
          <li><capacity>Manipulation</capacity><setMax>0</setMax></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>OathSlash_Fight_Hediff</defName>
    <label>御狐神源</label>
    <description>神源自御狐体内涌现……</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(200,50,50)</defaultLabelColor>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
      <disappearsAfterTicks>3600</disappearsAfterTicks>
      <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <label>释放</label>
        <minSeverity>0</minSeverity>
        <hungerRateFactor>0.2</hungerRateFactor>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>1.314</offset></li>
          <li><capacity>Manipulation</capacity><offset>1.314</offset></li>
          <li><capacity>Moving</capacity><offset>0.52</offset></li>
        </capMods>
        <statFactors>
          <ImmunityGainSpeed>5.2</ImmunityGainSpeed>
          <InjuryHealingFactor>5.2</InjuryHealingFactor>
          <MeleeDamageFactor>1.314</MeleeDamageFactor>
        </statFactors>
      </li>
      <li>
        <label>解放</label>
        <minSeverity>52</minSeverity>
        <hungerRateFactor>0.2</hungerRateFactor>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>5.2</offset></li>
          <li><capacity>Manipulation</capacity><offset>5.2</offset></li>
          <li><capacity>Moving</capacity><offset>1.314</offset></li>
        </capMods>
        <statFactors>
          <ImmunityGainSpeed>52</ImmunityGainSpeed>
          <InjuryHealingFactor>52</InjuryHealingFactor>
          <MeleeDamageFactor>5.2</MeleeDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
  
  <ToolCapacityDef>
    <defName>OathSlash_Cut</defName>
    <label>誓约之刃斩击</label>
  </ToolCapacityDef>

</Defs>