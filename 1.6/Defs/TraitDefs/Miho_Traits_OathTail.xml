<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 誓约之尾 -->
  <TraitDef>
    <defName>Miho_TheOathTail</defName>
    <commonality>0.0</commonality>
    <degreeDatas>
      <li>
        <label>御狐 誓约之尾</label>
        <description>符皇之御狐，最为珍视的两柄佩刀：其一，神狐；其二，仙狐。\n\n符皇大婚，日后留其一，令其二视后如己侍之。</description>
        <statOffsets>
            <WorkSpeedGlobal>1.3</WorkSpeedGlobal>
        </statOffsets>
        <statFactors>
            <WorkSpeedGlobal>1.4</WorkSpeedGlobal>
        </statFactors>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="AriandelLibrary.AL_NoSkillDecay_Extension"/>
      <li Class="AriandelLibrary.AL_PsychicShockReflect_Extension" />
      <li Class="AriandelLibrary.AL_IgnoreGenePenalty_Extension">
        <skill>Melee</skill>
      </li>
      <li Class="AriandelLibrary.AL_LockSkill_Extension">
        <skill>Melee</skill>
        <level>32</level>
        <preventDecay>true</preventDecay>
      </li>
    </modExtensions>
  </TraitDef>

  <TraitDef>
