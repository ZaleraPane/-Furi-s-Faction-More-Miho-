    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <label>惊鸿绝艳</label>
        <description>[PAWN_nameDef]的美貌使其他生灵皆为之动容。</description>
        <degree>1</degree>
        <statOffsets>
          <PawnBeauty>5.2</PawnBeauty>
          <MentalBreakThreshold>-2</MentalBreakThreshold>
        </statOffsets>
        <statFactors>
          <CertaintyLossFactor MayRequire="Ludeon.RimWorld.Ideology">0.01</CertaintyLossFactor>
        </statFactors>
      </li>
      <li>
        <label>风华绝代</label>
        <description>[PAWN_nameDef]才华横溢，姿色冠绝当代。</description>
        <degree>2</degree>
        <statOffsets>
          <PawnBeauty>5.2</PawnBeauty>
          <MentalBreakThreshold>-2</MentalBreakThreshold>
        </statOffsets>
        <statFactors>
          <CertaintyLossFactor MayRequire="Ludeon.RimWorld.Ideology">0.01</CertaintyLossFactor>
        </statFactors>
      </li>
      <li>
        <label>倾世盛颜</label>
        <description>[PAWN_nameDef]的颜值使世间一切可仅为她而倾覆，整个世界仿佛为做她的背景板而生。</description>
        <degree>3</degree>
        <statOffsets>
          <PawnBeauty>13.14</PawnBeauty>
          <MentalBreakThreshold>-2</MentalBreakThreshold>
        </statOffsets>
        <statFactors>
          <CertaintyLossFactor MayRequire="Ludeon.RimWorld.Ideology">0.01</CertaintyLossFactor>
