    <AbilityDef ParentName="MihoPsycastBase">
		<defName>Miho_Ability_OriginPolaris</defName>
		<label>Elemental Bombardment</label>
		<aiCanUse>true</aiCanUse>
		<description>Generate an Element-infused Arcane Meteor to bombard the target.</description>
		<iconPath>Icon/Abilities/MihoPolaris</iconPath>
		<writeCombatLog>true</writeCombatLog>
		<groupDef>Miho_OriginPolaris</groupDef>
		<statBases>
			<Ability_PsyfocusCost>0.052</Ability_PsyfocusCost>
            <Ability_EntropyGain>52</Ability_EntropyGain>
		</statBases>
		<verbProperties>
			<warmupTime>0</warmupTime>
			<range>131.4</range>
			<targetParams>
				<canTargetSelf>false</canTargetSelf>
				<canTargetLocations>true</canTargetLocations>
                <canTargetBuildings>true</canTargetBuildings>
				<canTargetAnimals>true</canTargetAnimals>
				<canTargetPawns>true</canTargetPawns>
				<canTargetMechs>true</canTargetMechs>
			</targetParams>
		</verbProperties>
		<comps>
			<li Class="CompProperties_AbilityLaunchProjectile">
				<projectileDef>MihoPolaris_OriginProj</projectileDef>
			</li>
            <li Class="AriandelLibrary.CompProperties_AbilityOnlyPawnKind">
                <pawnKinds>
                    <li>FR_TheOathTail_Alpha</li>
                    <li>FR_TheOathTail_Beta</li>
                    <li>FR_KT_Imperatofu</li>
                    <li>FR_KT_Imperasofu</li>
                </pawnKinds>
            </li>
		</comps>
	</AbilityDef>

    <ThingDef ParentName="BaseBullet">
		<defName>MihoPolaris_OriginProj</defName>
		<label>Elemental Bombardment</label>
		<thingClass>Projectile_Explosive</thingClass>
		<graphicData>
			<texPath>Things/Fleck/Fragment</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>1.3</drawSize>
		</graphicData>
		<projectile>
			<damageDef>Miho_MagicBombPolaris</damageDef>
			<damageAmountBase>131.4</damageAmountBase>
			<armorPenetrationBase>1.314</armorPenetrationBase>
			<stoppingPower>5.2</stoppingPower>
			<speed>520</speed>
			<explosionRadius>0.52</explosionRadius>
			<alwaysFreeIntercept>false</alwaysFreeIntercept>
			<flyOverhead>true</flyOverhead>
			<soundHitThickRoof>Artillery_HitThickRoof</soundHitThickRoof>
			<soundAmbient>MortarRound_Ambient</soundAmbient>
			<preExplosionSpawnThingDef>Miho_SKYIncomingPolaris</preExplosionSpawnThingDef>
			<preExplosionSpawnChance>1</preExplosionSpawnChance>
		</projectile>
		<comps>
			<li Class="CompProperties_ProjectileEffecter">
				<effecterDef>Miho_MagicCirclePolarisProj</effecterDef>
			</li>
		</comps>
	</ThingDef>

