    <allowedCultures>
      <li>Furi_Culture</li>
    </allowedCultures>
    <fixedIdeo>true</fixedIdeo>
    <ideoName>氷玥国教</ideoName>
    <ideoDescription>氷玥国教最初是符漓在氷都的一些信仰符皇的民间团体。\n\n后形成组织化的宗教，被正式立为氷玥的国教。\n\n那曾被驱逐的非法组织仍试图进犯氷玥，多次命杂牌军队骚扰氷玥的边境。\n\n符漓最终全歼了非法组织的杂牌军队并将他的势力全都赶下了海。</ideoDescription>
    <deityPresets>
      <li>
        <nameType>
          <name>符皇</name>
          <type>氷幕·血月</type>
        </nameType>
        <gender>Male</gender>
        <iconPath>Faction/Furi_FactionIcon</iconPath>
      </li>
    </deityPresets>

    <requiredMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Furi_Meme_C</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Furi_Meme_S</li>
    </requiredMemes>

    <allowedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Furi_Meme_C</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Furi_Meme_S</li>
    </allowedMemes>

    <disallowedPrecepts>
    </disallowedPrecepts>

  </FactionDef>


